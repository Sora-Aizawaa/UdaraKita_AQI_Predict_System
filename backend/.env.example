# Dipakai saat menjalankan backend lokal (opsional) dan sebagai daftar variabel di Render.
# Alamat frontend yang boleh memanggil API ini, pisahkan dengan koma, tanpa garis miring di akhir.
CORS_ORIGINS=http://localhost:5173,https://udarakita.vercel.app
